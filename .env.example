# 复制本文件为 .env 并填入你的 DeepSeek API Key（.env 已在 .gitignore 中，不会被提交）
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-YOUR_KEY_HERE
# 可选：
# PORT=3000
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 站点对外访问地址（SEO canonical / sitemap / og:image 用）。
# 本地开发可留空（默认 http://localhost:3000），上线后改为实际域名，例如：
# SITE_URL=https://yueshushu.top
